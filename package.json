{
  "name": "jev-trader",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "^3.0.0",
    "@kuru-labs/kuru-sdk": "^0.0.95",
    "ai": "^7.0.103",
    "ethers": "5"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "paper:demo": "bun run scripts/paper-demo.ts",
    "paper:replay": "bun run scripts/paper-replay.ts",
    "paper:start": "bun --no-env-file scripts/paper-control.ts start",
    "paper:status": "bun --no-env-file scripts/paper-control.ts status",
    "paper:stop": "bun --no-env-file scripts/paper-control.ts stop",
    "paper:doctor": "bun --no-env-file scripts/paper-doctor.ts"
  }
}
